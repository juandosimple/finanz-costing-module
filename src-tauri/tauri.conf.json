{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Finanz analyzer",
  "version": "0.3.0",
  "identifier": "com.juando.aianalyzer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Finanz analyzer",
        "width": 1320,
        "height": 860,
        "minWidth": 1080,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5NjA5NzAxQkZEOTAyNDAKUldSQUF0bS9BWmRnR1hTdkluWjhZNDI1Z3dTWENoYStwNnpBQzBINVFlUERrN05XbXVUZElnc3kK",
      "endpoints": [
        "https://github.com/juandosimple/finanz-costing-module/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
